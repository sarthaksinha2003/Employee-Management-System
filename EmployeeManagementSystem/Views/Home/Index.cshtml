@model EmployeeManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold">
        Employee Management System
    </h1>
    <p class="lead text-muted">
        Welcome to your Employee Management Dashboard.
    </p>
    <p class="text-secondary">
        Manage employees, departments, and salary information efficiently from a single place.
    </p>
</div>


<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow h-100 dashboard-card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="bi bi-people-fill"></i>
                    Employees
                </h4>
            </div>

            <div class="card-body">
                <p class="text-muted">

                    Manage employee records including
                    creating, updating,
                    viewing and deleting employees.

                </p>
                <div class="d-flex gap-2">
                    <a asp-controller="Employee"
                       asp-action="List"
                       class="btn btn-primary">

                        <i class="bi bi-list"></i>

                        View

                    </a>
                    <a asp-controller="Employee"
                       asp-action="Create"
                       class="btn btn-success">
                        <i class="bi bi-person-plus-fill"></i>
                        Add
                    </a>
                </div>
            </div>

            <div class="card-footer text-muted">
                Employee Module
            </div>

        </div>

    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow h-100 dashboard-card">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">
                    <i class="bi bi-building-fill"></i>
                    Departments
                </h4>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    Manage company departments
                    and organizational structure.
                </p>
                <div class="d-flex gap-2">
                    <a asp-controller="Department"
                       asp-action="List"
                       class="btn btn-primary">
                        <i class="bi bi-list"></i>
                        View
                    </a>
                    <a asp-controller="Department"
                       asp-action="Create"
                       class="btn btn-success">
                        <i class="bi bi-person-plus-fill"></i>
                        Add
                    </a>
                </div>
            </div>

            <div class="card-footer text-muted">
                Department Module
            </div>
        </div>
    </div>

</div>

<div class="row mt-4 g-4 justify-content-center">
    <div class="col-md-4">
        <div class="card text-center shadow h-100 dashboard-card">
            <div class="card-body">

                <i class="bi bi-people-fill display-5 text-primary"></i>
                <h5 class="mt-3"> Total Employees </h5>
                <h2> @Model.TotalEmployees </h2>

            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow h-100 dashboard-card">
            <div class="card-body">

                <i class="bi bi-diagram-3-fill display-5 text-primary"></i> 
                <h5 class="mt-3"> Total Departments</h5>
                <h2>@Model.TotalDepartments</h2>

            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow h-100 dashboard-card">
            <div class="card-body">

                <i class="bi bi-cash-stack display-5 text-primary"></i>
                <h5 class="mt-3"> Average Salary</h5>
                <h2>₹@Model.AverageSalary.ToString("N2")</h2>

            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow h-100 dashboard-card ">
            <div class="card-body">

                <i class="bi bi-wallet2 display-5 text-primary"></i>
                <h5 class="mt-3"> Total Payroll </h5>
                <h2>₹@Model.TotalSalary.ToString("N2")</h2>

            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow h-100 dashboard-card">
            <div class="card-body">

                <i class="bi bi-trophy-fill display-5 text-primary"></i>
                <h5 class="mt-3"> Highest Salary </h5>
                <h2>₹@Model.HighestSalary.ToString("N2")</h2>

            </div>
        </div>
    </div>
</div>