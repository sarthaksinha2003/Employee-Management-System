@model List<EmployeeManagementSystem.Models.Employee>;
@{
    ViewData["Title"] = "List Page";
}

<h2 class="mb-4">Employee List</h2>
<a asp-action="Create" class="btn btn-success mb-3">
    <i class="bi bi-person-plus-fill"> Add New Employee </i>
</a>
<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mb-3">
    <i class="bi bi-house-door-fill"> Back To Home </i>
</a>

<table class="table table-striped table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

    @foreach (Employee employee in Model)
    {
        <tr>
            <td>@employee.Id</td>
            <td>@employee.Name</td>
            <td>@employee.Department?.Name</td>
            <td>@employee.Salary</td>
            <td>
                <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-info btn-sm">
                    <i class="bi bi-eye"> Details </i>
                </a>
                <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-warning btn-sm">
                    <i class="bi bi-pencil-square"> Edit </i>
                </a>
                <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-danger btn-sm">
                    <i class="bi bi-trash"> Delete </i>
                </a>
            </td>
        </tr>
    }

    </tbody>

</table>