@model EmployeeManagementSystem.Models.Employee
@{
    ViewData["Title"] = "Details Page";
}

<h2>Employee Details</h2>
<hr />

@if (Model == null)
{
    <p>No Employee Found.</p>
}
else
{
    <p><strong>ID:</strong> @Model.Id</p>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Department:</strong> @Model.Department?.Name</p>
    <p><strong>Salary:</strong> @Model.Salary</p>
}

<a asp-action="List" class="btn btn-secondary">
    <i class="bi bi-list-ul"> Back To List </i>
</a>