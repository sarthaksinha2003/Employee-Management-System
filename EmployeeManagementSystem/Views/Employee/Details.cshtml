@model EmployeeManagementSystem.Models.Employee
@{
    ViewData["Title"] = "Details Page";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow border-info">

            <div class="card-header bg-info text-white">
                <h4 class="mb-0">
                    <i class="bi bi-eye-fill"></i>
                    Employee Details
                </h4>
            </div>

            <div class="card-body">
                
                @if (Model == null)
                {
                    <p>No Employee Found.</p>
                }
                else
                {
                    <div class="mb-3">
                        <strong>ID:</strong>
                        <p class="mb-0">@Model.Id</p>
                    </div>
                    <div class="mb-3">
                        <strong>Name:</strong>
                        <p class="mb-0">@Model.Name</p>
                    </div>
                    <div class="mb-3">
                        <strong>Department:</strong>
                        <p class="mb-0">@Model.Department?.Name</p>
                    </div>
                    <div class="mb-3">
                        <strong>Salary:</strong>
                        <p class="mb-0">@Model.Salary</p>
                    </div>

                    <div class="mt-4">
                        <a asp-action="List" class="btn btn-secondary">
                            <i class="bi bi-arrow-left-circle"> Cancel </i>
                        </a>
                    </div>
                }

            </div>
            
        </div>

    </div>

</div>