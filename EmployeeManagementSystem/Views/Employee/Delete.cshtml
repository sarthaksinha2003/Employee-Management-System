@model EmployeeManagementSystem.Models.Employee
@{
    ViewData["Title"] = "Delete Page";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow border-danger">

            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">
                    <i class="bi bi-trash-fill"></i>
                    Delete Employee
                </h4>
            </div>

            <div class="card-body">

                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Are you sure you want to delete this employee?
                </div>

                <hr />

                <div class="mb-3">
                    <strong>Name:</strong>
                    <p class="mb-0">@Model.Name</p>
                </div>

                <div class="mb-3">
                    <strong>Department:</strong>
                    <p class="mb-0">@Model.Department?.Name</p>
                </div>

                <div class="mb-3">
                    <strong>Salary:</strong>
                    <p class="mb-0">₹@Model.Salary.ToString("N2")</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input asp-for="Id" type="hidden" />
                    <button class="btn btn-danger" type="submit">
                        <i class="bi bi-trash-fill"> Delete </i>
                    </button>

                    <a asp-action="List" class="btn btn-secondary">
                        <i class="bi bi-x-circle"> Cancel </i>
                    </a>
                </form>

            </div>

        </div>

    </div>

</div>