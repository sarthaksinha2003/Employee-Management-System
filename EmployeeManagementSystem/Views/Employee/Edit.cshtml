@model EmployeeManagementSystem.ViewModels.EmployeeFormViewModel

<h2>Edit Employee</h2>

@if (Model == null)
{
    <p>No Employee Found.</p>
}
else
{
    <form asp-action="Edit" method="post">

        <div asp-validation-summary="All"
        class="text-danger">
        </div>

        <input asp-for="Employee.Id" type="hidden" />

        <div class="mb-3">
            <label asp-for="Employee.Name"></label>
            <input asp-for="Employee.Name" class="form-control" />
            <span asp-validation-for="Employee.Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Employee.DepartmentId"></label>
            <select asp-for="Employee.DepartmentId"
                    asp-items="Model.Departments"
                    class="form-select">
            </select>
            <span asp-validation-for="Employee.Department" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Employee.Salary"></label>
            <input asp-for="Employee.Salary" class="form-control" />
            <span asp-validation-for="Employee.Salary" class="text-danger"></span>
        </div>

        <div>
            <button type="submit" class="btn btn-primary">
                Update Employee
            </button>

            <a asp-action="List" class="btn btn-secondary">
                Back To List
            </a>
        </div>

    </form>

    @section Scripts
    {
        <partial name="_ValidationScriptsPartial" />
    }
}