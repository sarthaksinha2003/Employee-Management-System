@model EmployeeManagementSystem.Models.Department
@{
    ViewData["Title"] = "Edit Page";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow border-primary">

            <div class="card-header bg-primary text-white">

                <h4 class="mb-0">

                    <i class="bi bi-person-plus-fill"></i>

                    Create Department

                </h4>

            </div>

            <div class="card-body">

                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <lable asp-for="Name" class="form-label fw-semibold"></lable>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-floppy-fill"> Save </i>
                        </button>
                        <a asp-action="List" class="btn btn-secondary">
                            <i class="bi bi-arrow-left-circle">  Cancel </i>
                        </a>
                    </div>
                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <parial name="_ValidationScriptsPartial" />
}