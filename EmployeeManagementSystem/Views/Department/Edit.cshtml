@model EmployeeManagementSystem.Models.Department
@{
    ViewData["Title"] = "Edit Page";
}

<h2> Edit Department </h2>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden"/>

    <div class="mb-3">
        <lable asp-for="Name"></lable>
        <input asp-for="Name" class="form-control"/>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">
        <i class="bi bi-pencil-square"> Update </i>
    </button>

    <a asp-action="List" class="btn btn-secondary">
        <i class="bi bi-list-ul"> Back To List </i>
    </a>
</form>

@section Scripts {
    <parial name="_ValidationScriptsPartial" />
}