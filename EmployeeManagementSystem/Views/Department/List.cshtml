@model List<EmployeeManagementSystem.Models.Department>
@{
    ViewData["Title"] = "List Page";
}

<h2 class="mb-4">Departments List</h2>
<a asp-action="Create" class="btn btn-success mb-3">
    <i class="bi bi-plus-circle-fill"> Add New Department </i>
</a>
<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mb-3">
    <i class="bi bi-house-door-fill"> Back To Home </i>
</a>

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Department Name</th>
            <th>Actions</th>
        </tr>
        
    </thead>

    <tbody>
        @foreach (Department department in Model)
        {
            <tr>
                <td>@department.Id</td>
                <td>@department.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-info btn-sm">
                        <i class="bi bi-eye"> Details </i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"> Edit </i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@department.Id" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"> Delete </i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>